import std.math;
//generics would make this SO much easier
fn read_rand(arr: int[]): int{
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
fn read_rand(arr: bool[]): bool{
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
fn read_rand(arr: float[]): float {
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
fn read_rand(arr: str[]): str{
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
//just for good measure, nested int[]
//fn read_rand(arr: int[][]): int[] {
//    let idx = math.rand_int(0, len(arr) - 1);
//    return arr[idx];
//}
//will need to fix name mangling before this will work
fn read_arr(arr: int[], elem: int) {
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
fn read_arr(arr: bool[], elem: bool){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
fn read_arr(arr: float[], elem: float){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
fn read_arr(arr: str[], elem: str){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
fn read_arr(arr: int[][], elem: int[]){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}