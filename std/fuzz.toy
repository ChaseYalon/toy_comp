import std.math;
extern fn toy_fuzz_loop_budget(): int;
//how many iterations a generated loop may still run. decays as the program ages, so a deeply
//nested program throttles itself instead of running for hours
export fn loop_budget(): int {
    return toy_fuzz_loop_budget();
}
//generics would make this SO much easier
export fn read_rand(arr: int[]): int{
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: bool[]): bool{
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: float[]): float {
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: str[]): str{
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: str[][]): str[] {
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: int[][]): int[] {
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: bool[][]): bool[] {
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn read_rand(arr: float[][]): float[] {
    let idx: int = math.rand_int(0, len(arr) - 1);
    return arr[idx];
}
export fn write_arr(arr: int[], elem: int) {
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: bool[], elem: bool){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: float[], elem: float){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: str[], elem: str){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: int[][], elem: int[]){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: str[][], elem: str[]){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: bool[][], elem: bool[]){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}
export fn write_arr(arr: float[][], elem: float[]){
    let idx: int = math.rand_int(0, len(arr) - 1);
    arr[idx] = elem;
}